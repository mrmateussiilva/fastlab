# ==============================================================================
# INTELIGÊNCIA ARTIFICIAL (OpenAI / OpenRouter / Replicate)
# ==============================================================================
OPENAI_API_KEY=

# URL Base para gateways compatíveis com OpenAI
# - Deixe vazio para usar a API oficial da OpenAI (https://api.openai.com/v1)
# - Para usar OPENROUTER, defina: https://openrouter.ai/api/v1
OPENAI_BASE_URL=

# Modo de renderização:
# - 'auto' (padrão): usa images.edit com o mockup (gpt-image) e, se falhar, Vision + geração (ou OpenRouter Unified Image API).
# - 'vision_generate': força análise multimodal + geração fotográfica.
# - 'edit': força chamada direta a openai.images.edit (para proxies locais/inpainting).
OPENAI_IMAGE_MODE=auto

# Modelos OpenAI (ou OpenRouter):
# ATENÇÃO: DALL-E 2/3 foram desligados pela OpenAI em 12/05/2026 (erro "model 'dall-e-3' does not exist").
# - Com OpenAI oficial:
#     OPENAI_VISION_MODEL=gpt-4o
#     OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst  (precisão de edição) ou gpt-image-2.5-flare (rápido)
# - Com OpenRouter (exemplos):
#     OPENAI_VISION_MODEL=openai/gpt-4o  (ou google/gemini-2.0-flash-001)
#     OPENAI_IMAGE_MODEL=openai/gpt-image-2.5-sunburst (ou black-forest-labs/flux-1-schnell, bytedance-seed/seedream-4.5)
OPENAI_VISION_MODEL=gpt-4o
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
# Opcional: low | medium | high | auto
OPENAI_IMAGE_QUALITY=medium

# Provedor alternativo opcional (Replicate / Flux / SDXL)
# AI_PROVIDER=openai # 'openai' ou 'replicate'
# REPLICATE_API_TOKEN=
# REPLICATE_MODEL=black-forest-labs/flux-schnell

# ==============================================================================
# RATE LIMIT (Upstash Redis)
# ==============================================================================
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

AI_GENERATION_LIMIT_PER_HOUR=2
AI_GLOBAL_GENERATION_LIMIT=25

# ==============================================================================
# AUTENTICAÇÃO (Clerk)
# ==============================================================================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ==============================================================================
# BANCO DE DADOS (Supabase)
# ==============================================================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave Service Role para bypass de RLS no backend admin (opcional mas recomendado)
SUPABASE_SERVICE_ROLE_KEY=

# Senha de acesso ao Painel Admin (/admin ou /admin/themes)
# Nota: Sempre que alterar na Vercel, faça um "Redeploy" do projeto para aplicar.
ADMIN_PASSWORD=
